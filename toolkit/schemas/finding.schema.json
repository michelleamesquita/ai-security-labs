{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Security Finding",
  "description": "Standardized security finding schema for AI triage pipelines",
  "type": "object",
  "required": ["id", "title", "severity", "cwe", "component", "description"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SEC-\\d{4}-\\d{3}$",
      "description": "Unique finding ID, format SEC-YYYY-NNN"
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "Vulnerability type + component + CWE"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "cvss_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0
    },
    "cvss_vector": {
      "type": "string",
      "pattern": "^CVSS:3\\.",
      "description": "CVSS 3.x vector string"
    },
    "cwe": {
      "type": "string",
      "pattern": "^CWE-\\d+$"
    },
    "component": {
      "type": "string",
      "description": "File path or component name"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "description": "What, where, how to exploit"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "code_snippet": {"type": "string"},
        "payload": {"type": "string"},
        "request": {"type": "string"},
        "response": {"type": "string"},
        "screenshot": {"type": "string", "format": "uri"}
      }
    },
    "fix_suggestion": {
      "type": "object",
      "properties": {
        "approach": {"type": "string"},
        "code_diff": {"type": "string"},
        "references": {
          "type": "array",
          "items": {"type": "string", "format": "uri"}
        }
      }
    },
    "tool_source": {
      "type": "string",
      "description": "SAST/DAST/SCA tool that found this"
    },
    "detection_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "ai_triage": {
      "type": "object",
      "properties": {
        "verdict": {"type": "string", "enum": ["real", "false_positive", "needs_review"]},
        "confidence": {"type": "number"},
        "reasoning": {"type": "string"},
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "status": {
      "type": "string",
      "enum": ["open", "in_progress", "fixed", "retesting", "closed", "accepted_risk", "false_positive"]
    },
    "retest": {
      "type": "object",
      "properties": {
        "plan": {"type": "string", "format": "uri"},
        "evidence": {"type": "string", "format": "uri"},
        "verdict": {"type": "string", "enum": ["eficaz", "parcial", "invalida"]},
        "executed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}