# Environment Variables — AI Security Labs
# Copie para .env e preencha as chaves que for usar
# NUNCA commitar .env!

# ── LLM Providers ─────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
DEEPSEEK_API_KEY=sk-...

# ── Jev (TypeSafe) ────────────────────────────────
TYPESAFE_API_KEY=ts_...

# ── DefectDojo ────────────────────────────────────
DOJO_URL=https://defectdojo.example.com
DOJO_TOKEN=...
DOJO_ENGAGEMENT=1

# ── GitHub ────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ── PentAGI ───────────────────────────────────────
PENTAGI_ADMIN_PASSWORD=change-me

# ── ARTEX ─────────────────────────────────────────
ARTEX_DB_URL=postgresql://artex:artex@localhost:5432/artex

# ── Docker ────────────────────────────────────────
DOCKER_HOST=unix:///var/run/docker.sock